{
	"name": "duplicateshortcut",
	"displayName": "DuplicateShortcut",
	"description": "",
	"version": "0.0.2",
	"engines": {
		"vscode": "^1.92.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "duplicateshortcut.duplicate",
				"title": "Duplication"
			}
		],
		"keybindings": [
			{
				"command": "duplicateshortcut.duplicate",
				"key": "ctrl+d",
				"when": "editorTextFocus"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check .",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.19.3",
		"@types/vscode": "^1.92.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^2.5.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"js-yaml": "4.3.1",
		"picomatch": "2.3.2",
		"serialize-javascript": "7.1.0",
		"flatted": "3.4.2",
		"glob@10": "10.5.0",
		"minimatch@5": "5.1.8",
		"minimatch@9": "9.0.9",
		"brace-expansion@1": "1.1.16",
		"brace-expansion@2": "2.1.4"
	}
}
