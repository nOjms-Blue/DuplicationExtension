{
	"name": "duplicateshortcut",
	"displayName": "DuplicateShortcut",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.92.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "duplicateshortcut.duplicate",
				"title": "Duplication"
			}
		],
		"keybindings": [
			{
				"command": "duplicateshortcut.duplicate",
				"key": "ctrl+d",
				"when": "editorTextFocus"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "bun run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "bun run compile && bun run lint",
		"lint": "biome check .",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.19.3",
		"@types/vscode": "^1.107.0",
		"@vscode/test-cli": "^0.0.9",
		"@vscode/test-electron": "^2.5.2",
		"typescript": "^5.9.3"
	}
}
